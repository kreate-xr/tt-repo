# Copy this file to .env.local and fill in your values. .env.local is
# gitignored — don't commit real config. The apiKey itself is safe to expose
# (Firestore security rules are what protect data), but keeping local config
# out of version control prevents accidental cross-project pollution.
#
# ── Two projects, two files ──────────────────────────────────────────────────
#   .env.local       → sportyxr-test  (dev server, `npm run build`, smoke scripts)
#   .env.prod.local  → sportyxr-tech  (`npm run dev:prod` / `build:prod` / `deploy:prod`)
# Vite loads .env.prod.local ON TOP of .env.local when run with `--mode prod`,
# so .env.prod.local must repeat EVERY key below with its prod value — a key
# left out silently inherits the test value into the prod bundle. Both files
# match .gitignore's `.env.*.local`. Test is the default everywhere on purpose:
# only the explicit `:prod` scripts (or `--project prod`) can touch production.

# Firebase / GCP project config — get these from the Firebase Console
# (Project Settings → "Your apps" → Web app), or from GCP Console (APIs &
# Services → Credentials for the apiKey, plus project info elsewhere).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NOTE: the Firestore database is NOT configured here. It is a named database
# ('tabletennis'), pinned as DATABASE_ID in js/network/firebaseClient.js and
# mirrored in firebase.json so the rules deploy to the same place.

# Google Tag Manager container, e.g. GTM-XXXXXXX. Unset means GTM does not
# load at all — no error, no tag. Bootstrapped from js/analytics/gtm.js rather
# than an inline snippet, because firebase.json's script-src has no
# 'unsafe-inline'; see that file before changing how the tag is delivered.
# Note: GTM Custom HTML tags are blocked by that same CSP.
VITE_GTM_CONTAINER_ID=

# Optional: override telemetry endpoint (default: same-origin :8081/telemetry)
# VITE_TELEMETRY_URL=

# Optional: TURN relay for players behind restrictive NAT (~15% of sessions
# fail to connect without it). Comma-separated URLs; include both a UDP and a
# TLS/TCP-443 entry so corporate/hotel firewalls are covered. For production,
# prefer short-lived credentials injected via LobbyManager({ iceServers })
# rather than build-time env vars.
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Set DEV_HTTP=1 (not VITE_*) before `npm run dev` to disable basic-ssl when
# testing with the WebXR Emulator extension on desktop Chrome:
#   $env:DEV_HTTP="1"; npm run dev

# ── Firebase App Check (js/network/appCheck.js) ───────────────────────────────
# reCAPTCHA Enterprise SCORE-based site key, Web type, "Use checkbox challenge"
# left OFF. Create it in GCP Console → Security → reCAPTCHA (enable the
# reCAPTCHA Enterprise API if prompted), register the hosting domain(s) plus
# localhost, then register the SAME key under Firebase Console → App Check →
# Apps → your web app → reCAPTCHA Enterprise. Public, ships in every build.
# Unset = App Check off (loud console warning); fine until enforcement is on.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Debug token for `npm run dev` and the scripts/check-*.mjs smoke tests — the
# dev origin is a LAN address that reCAPTCHA cannot be registered for.
# Firebase Console → App Check → Apps → ⋮ Manage debug tokens → Add → any
# UUID. Deliberately NOT VITE_-prefixed: vite.config.js substitutes it only
# under the dev server, so `vite build` cannot inline it. Treat it like a
# password: whoever has it can write to Firestore as this app.
APPCHECK_DEBUG_TOKEN=

# ── Accounts, free trial and payments (functions/, js/account/) ──────────────
# PayLayer service origin (D:\Bhuvnesh_Data\Payment). Its browser SDK is loaded
# from here at checkout. Test project → the TEST-mode PayLayer deployment;
# .env.prod.local → the LIVE one. Public. Must also be in firebase.json's CSP
# (script-src + connect-src).
VITE_PAYLAYER_URL=

# Dev server only (not VITE_): forwards /api and /webhooks, which production
# serves through a Firebase Hosting rewrite. For headset dev against the
# deployed test backend:
#   API_PROXY_TARGET=https://sportyxr-test.web.app
# The e2e suite sets this itself (e2e/README.md).
# API_PROXY_TARGET=
