# `vite --mode e2e` — the end-to-end suite (e2e/README.md). Committed on
# purpose: every value is a local emulator / demo value, nothing real. Vite
# gives this file priority over .env.local, so the e2e run never touches the
# test or prod project. Empty values switch off GTM and App Check.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tt
VITE_FIREBASE_STORAGE_BUCKET=demo-tt.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_GTM_CONTAINER_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
APPCHECK_DEBUG_TOKEN=

VITE_EMULATOR_AUTH=127.0.0.1:9199
VITE_EMULATOR_FIRESTORE=127.0.0.1:8189

# Fake PayLayer (e2e/fakePayLayer.mjs) — stands in for PayLayer + Razorpay.
VITE_PAYLAYER_URL=http://127.0.0.1:8790

# /api and /webhooks → the Functions emulator's `api` function.
API_PROXY_TARGET=http://127.0.0.1:5101/demo-tt/us-central1/api
