rules_version = '2';

// Prototype-grade rules: any authenticated user (including anonymous) can
// read + write any room. The Anonymous-auth requirement is the only gate —
// it stops crawlers and unauthenticated abuse, but anyone who can run the
// game can also interfere with any room they know the code of.
//
// Production hardening to add later:
//   - Cap room size: writes to /rooms/{code} disallowed if data.host AND
//     data.guest are both present and the writer isn't one of them
//   - TTL: deny writes to rooms whose createdAt > 1 hour old (paired with a
//     Cloud Functions scheduled job that deletes them)
//   - Validate offer/answer shape (must be {type, sdp})
//   - Per-IP rate-limit room creation via App Check / reCAPTCHA Enterprise
//
// Deploy:
//   gcloud firestore rules deploy firestore.rules
// Or via Firebase CLI:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room} {
      allow read, write: if request.auth != null;

      match /hostCandidates/{candidate} {
        allow read, write: if request.auth != null;
      }
      match /guestCandidates/{candidate} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
