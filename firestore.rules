rules_version = '2';

// Signaling rooms for WebRTC lobby (see js/network/SignalingClient.js).
//
// Model enforced here:
//   - All access requires (anonymous) auth.
//   - `list` is denied everywhere — room codes cannot be enumerated; a peer
//     must know the exact code to even read a room.
//   - The creating host stamps hostUid, the joining guest stamps guestUid
//     (both must equal request.auth.uid); every later write is bound to one
//     of those two uids, so a third party who guesses a live code cannot
//     overwrite the offer/answer or hijack the session.
//   - Rooms expire after MAX_AGE: no writes are accepted on an expired room,
//     and an expired room's code may be reclaimed by a new host. Orphaned
//     docs still need a scheduled Cloud Function (or Firestore TTL policy on
//     `createdAt`) to be physically deleted — rules can only stop their use.
//   - offer/answer must be shaped like session descriptions and are size-capped.
//
// Deploy: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Rooms are throwaway lobby docs; anything older than this is garbage.
    function fresh(data) {
      return data.createdAt is timestamp
        && request.time < data.createdAt + duration.value(2, 'h');
    }

    function isHost(data)  { return signedIn() && data.hostUid == request.auth.uid; }
    function isGuest(data) { return signedIn() && data.guestUid == request.auth.uid; }

    function validDescription(d, kind) {
      return d is map
        && d.keys().hasOnly(['type', 'sdp'])
        && d.type == kind
        && d.sdp is string
        && d.sdp.size() < 30000;
    }

    // The full doc a host writes when creating (or reclaiming) a room.
    function validHostDoc() {
      return request.resource.data.keys().hasOnly(['host', 'hostUid', 'createdAt'])
        && request.resource.data.host is map
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /rooms/{room} {
      // Exact-code reads only; onSnapshot on the doc is a `get`.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() && validHostDoc();

      allow update: if signedIn() && (
        // Host reclaims a code: full overwrite via txn.set. Allowed only for
        // the room's own host, or on an expired leftover from a dead session.
        (validHostDoc() && (isHost(resource.data) || !fresh(resource.data)))

        // Guest joins: adds exactly guest + guestUid, only while the slot is
        // empty (server-side room-size cap) and the room is still fresh.
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guest', 'guestUid'])
            && !('guest' in resource.data)
            && request.resource.data.guest is map
            && request.resource.data.guestUid == request.auth.uid
            && fresh(resource.data))

        // Host writes the offer.
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer'])
            && isHost(resource.data)
            && validDescription(request.resource.data.offer, 'offer')
            && fresh(resource.data))

        // Guest writes the answer.
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer'])
            && isGuest(resource.data)
            && validDescription(request.resource.data.answer, 'answer')
            && fresh(resource.data))

        // Guest vacates the room (leaveRoom: deletes guest/guestUid/answer).
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guest', 'guestUid', 'answer'])
            && isGuest(resource.data))
      );

      // Either participant may tear the room down.
      allow delete: if isHost(resource.data) || isGuest(resource.data);

      // ICE candidates: only the matching participant writes their own
      // collection; only room participants may read either collection.
      // (get() costs one extra read per rule evaluation — fine at the
      // handful-of-candidates scale of a lobby handshake.)
      function roomData() {
        return get(/databases/$(database)/documents/rooms/$(room)).data;
      }
      function isParticipant() {
        return isHost(roomData()) || isGuest(roomData());
      }
      function validCandidate() {
        return request.resource.data.keys()
            .hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
          && (!('candidate' in request.resource.data)
              || request.resource.data.candidate == null
              || (request.resource.data.candidate is string
                  && request.resource.data.candidate.size() < 2000));
      }

      match /hostCandidates/{candidate} {
        allow read: if isParticipant();
        allow create: if isHost(roomData()) && validCandidate();
        allow update, delete: if false;
      }
      match /guestCandidates/{candidate} {
        allow read: if isParticipant();
        allow create: if isGuest(roomData()) && validCandidate();
        allow update, delete: if false;
      }
    }

    // ── Beta instrumentation ────────────────────────────────────────────────
    //
    // Three write-only collections behind the same anonymous-auth gate as the
    // rooms above. Ownership is encoded in the PATH ({uid} segment), so every
    // rule is one comparison against request.auth.uid and there is no way to
    // address another player's document at all.
    //
    // Every one of them denies `read` outright — including to the author. The
    // client never needs its own analytics back, and a player's feedback text
    // or email must not be fetchable by anyone who can open the app. Reading
    // is via the Firebase console or the Admin SDK (scripts/query-sessions.mjs),
    // both of which bypass these rules by design.
    //
    // The uid survives the anonymous → Google upgrade in js/auth/upgrade.js
    // (linkWithPopup preserves it), so nothing here changes when a player
    // signs in — the rows they wrote as an anonymous visitor stay theirs.
    //
    // Cleanup: `sessions` needs a Firestore TTL policy on `endedAt`, same
    // caveat as the rooms above — rules stop use, not accumulation.

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Bounds mirror the constants in js/analytics/session.js — keep in step.
    // NOTE ON THE `in` GUARDS BELOW. Reading a key that is absent from a map
    // is an EVALUATION ERROR in rules, not a false — and an evaluation error
    // reaches the client as the same permission-denied a clean `false` does,
    // so it hides which condition actually rejected the write. Every required
    // field is therefore presence-checked before it is read.
    function validRunCreate() {
      return request.resource.data.keys().hasOnly(
          ['startedAt', 'endedAt', 'xrMode', 'ua', 'screen', 'appVersion',
           'durationMs', 'milestones', 'net', 'errors'])
        && 'startedAt' in request.resource.data
        && request.resource.data.startedAt == request.time
        && 'xrMode' in request.resource.data
        && request.resource.data.xrMode is string
        && request.resource.data.xrMode.size() < 32
        && (!('ua' in request.resource.data)
            || (request.resource.data.ua is string
                && request.resource.data.ua.size() <= 300))
        && (!('errors' in request.resource.data)
            || (request.resource.data.errors is list
                && request.resource.data.errors.size() <= 20));
    }

    // The single end-of-session merge. Restricted to the fields that write
    // makes, so a create cannot be laundered into an arbitrary document.
    function validRunUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['endedAt', 'durationMs', 'milestones', 'net', 'match',
                    'training', 'errors'])
        && 'endedAt' in request.resource.data
        && request.resource.data.endedAt == request.time
        && 'durationMs' in request.resource.data
        && request.resource.data.durationMs is int
        && 'milestones' in request.resource.data
        && request.resource.data.milestones is map
        && (!('errors' in request.resource.data)
            || (request.resource.data.errors is list
                && request.resource.data.errors.size() <= 20));
    }

    match /sessions/{uid}/runs/{runId} {
      allow create: if owns(uid) && validRunCreate();
      allow update: if owns(uid) && validRunUpdate();
      allow read, delete: if false;
    }

    function validFeedback() {
      return request.resource.data.keys()
          .hasOnly(['rating', 'text', 'context', 'createdAt'])
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt == request.time
        && (!('rating' in request.resource.data)
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 1
                && request.resource.data.rating <= 5))
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string
                && request.resource.data.text.size() <= 2000))
        && (!('context' in request.resource.data)
            || request.resource.data.context is map);
    }

    match /feedback/{uid}/items/{itemId} {
      allow create: if owns(uid) && validFeedback();
      allow read, update, delete: if false;
    }

    // One row per account. The doc id IS the uid, so an anonymous account can
    // register interest exactly once — the only rate limit rules can express.
    // Anonymous accounts are free to mint, so a determined actor can still
    // spam; App Check is the real fix and is a launch-time item, not a beta one.
    function validSignup() {
      return request.resource.data.keys()
          .hasOnly(['email', 'method', 'createdAt', 'mergedFrom'])
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt == request.time
        && 'email' in request.resource.data
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && 'method' in request.resource.data
        && request.resource.data.method in ['google', 'manual'];
    }

    match /signups/{uid} {
      allow create: if owns(uid) && validSignup();
      allow read, update, delete: if false;
    }
  }
}
