{
  "name": "tt-webxr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode prod",
    "build": "vite build",
    "build:prod": "vite build --mode prod",
    "deploy:test": "vite build && firebase deploy --only hosting,firestore:rules,functions --project test",
    "deploy:prod": "vite build --mode prod && firebase deploy --only hosting,firestore:rules,functions --project prod",
    "preview": "vite preview",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"jest -c tests-rules/jest.config.cjs\"",
    "lint": "eslint .",
    "test:e2e": "node e2e/run.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:local:expire": "node scripts/dev-local-expire.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(d3-delaunay|delaunator|robust-predicates)/)"
    ],
    "moduleNameMapper": {
      "^three$": "<rootDir>/node_modules/three/build/three.cjs"
    }
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "firebase": "^12.13.0",
    "msgpack-lite": "^0.1.26",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.32.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "playwright": "^1.63.0",
    "vite": "^8.0.5"
  }
}
