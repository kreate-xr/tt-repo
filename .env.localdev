# `npm run dev:local` (scripts/dev-local.mjs) — play the full accounts /
# trial / payment flow on this PC: Firebase emulators (project demo-tt-local,
# nothing real) + your local PayLayer in Razorpay TEST mode. Committed on
# purpose: no secrets here. Vite gives this file priority over .env.local.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tt-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tt-local
VITE_FIREBASE_STORAGE_BUCKET=demo-tt-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:local
VITE_GTM_CONTAINER_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
APPCHECK_DEBUG_TOKEN=

VITE_EMULATOR_AUTH=127.0.0.1:9199
VITE_EMULATOR_FIRESTORE=127.0.0.1:8189

# Local PayLayer (D:\Bhuvnesh_Data\Payment, `npm run dev`), PAY_ENV=test.
VITE_PAYLAYER_URL=http://127.0.0.1:8080

API_PROXY_TARGET=http://127.0.0.1:5101/demo-tt-local/us-central1/api
